{
    "name": "liamhackett/valueobjectcompiler",
    "description": "Compile strict type, read only value objects from JSON and XML",
    "type": "library",
    "autoload": {
        "psr-4": {
            "LiamH\\ValueObjectCompiler\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Liam Hackett"
        }
    ],
    "require": {
        "php": "^8.2||^8.3||^8.4||^8.5",
        "symfony/console": "*",
        "symfony/process": "*",
        "ext-simplexml": "*"
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "phpstan/phpstan": "^2.2.13",
        "doctrine/coding-standard": "^14.0",
        "phpunit/phpunit": "^13.3.3",
        "php-coveralls/php-coveralls": "^2.7.0",
        "ext-libxml": "*"
    },
    "bin": ["valueobjectcompiler"],
    "config": {
        "allow-plugins": false
    },
    "license": "BSD-3-Clause"
}
